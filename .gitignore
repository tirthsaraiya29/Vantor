# ============================================================
# VANTOR - Repository Ignore Rules
# ============================================================

# ------------------------------------------------------------
# Visual Studio
# ------------------------------------------------------------

.vs/
**/.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# ------------------------------------------------------------
# .NET / C# build artifacts
# ------------------------------------------------------------

**/bin/
**/obj/
**/TestResults/
*.dll
*.exe
*.pdb
*.deps.json
*.runtimeconfig.json

# ------------------------------------------------------------
# Visual C++ / MSBuild build artifacts
# ------------------------------------------------------------

**/x64/
**/x86/
**/Win32/
**/Debug/
**/Release/
**/ipch/
**/*.tlog/
*.ilk
*.exp
*.lib
*.pch
*.obj
*.idb
*.iobj
*.ipdb
*.lastbuildstate
*.recipe
*.sdf
*.opensdf

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

.venv/
venv/
env/
ENV/
virtualenv/

.python-version
pip-wheel-metadata/

.eggs/
*.egg-info/
wheels/
MANIFEST

# ------------------------------------------------------------
# IDEs and editors
# ------------------------------------------------------------

.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------
# Machine learning models and checkpoints
# ------------------------------------------------------------

*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.pb
*.h5
*.hdf5
*.keras
*.tflite
*.gguf
*.ggml

models/*
!models/.gitkeep

checkpoints/
weights/
pretrained/
huggingface_cache/
.cache/

# ------------------------------------------------------------
# Datasets and generated ML artifacts
# ------------------------------------------------------------

datasets/
dataset/
data/raw/
data/processed/

*.parquet
*.arrow
*.feather
*.npy
*.npz
*.pkl
*.pickle
*.joblib

# ------------------------------------------------------------
# Databases and runtime data
# ------------------------------------------------------------

*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-wal
*.sqlite-shm

# ------------------------------------------------------------
# Logs, reports and runtime output
# ------------------------------------------------------------

logs/
runs/
outputs/
experiments/
lightning_logs/
wandb/
mlruns/
tensorboard/

*.log
*.jsonl
*.tmp
*.bak
*.dmp
*.dump

# ------------------------------------------------------------
# Security / quarantine runtime data
# ------------------------------------------------------------

quarantine/
crashes/
dumps/

# ------------------------------------------------------------
# Secrets and credentials
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

secrets/
credentials/
product_keys.txt

# ------------------------------------------------------------
# Windows / macOS / Linux
# ------------------------------------------------------------

Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

.DS_Store
.AppleDouble
.LSOverride
.Trashes
.nfs*

# ------------------------------------------------------------
# Jupyter
# ------------------------------------------------------------

.ipynb_checkpoints/

# ------------------------------------------------------------
# Testing and coverage
# ------------------------------------------------------------

.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
pytestdebug.log
*.py

# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------

*.old
*.orig
*.rej
*.cache
*.temp

temp/
tmp/