<Window x:Class="Vantor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vantor.ViewModels"
        xmlns:views="clr-namespace:Vantor.Views"
        Title="Vantor Endpoint Security"
        MinWidth="1040" MinHeight="660" Width="1160" Height="740"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Dynamic View Mappings for MVVM ContentControl -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanCenterViewModel}">
            <views:ScanCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuarantineVaultViewModel}">
            <views:QuarantineVaultView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AntiTamperViewModel}">
            <views:AntiTamperView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ZipBombViewModel}">
            <views:ZipBombView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SignaturesViewModel}">
            <views:SignaturesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <!-- Main Window Outer Border with Subtle Glass Shadow -->
    <Border Background="{StaticResource BrushBgDeep}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1.5" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Top TitleBar (Chrome Draggable) -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource BrushBgObsidian}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Path Data="{StaticResource IconShield}" Fill="{StaticResource BrushCyanAccent}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="VANTOR // ENDPOINT SECURITY" Foreground="{StaticResource BrushCyanAccent}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    
                    <!-- Dynamic Engine Status Pill -->
                    <Border Background="#10172A" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding EngineStatusColor}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding EngineStatusText}" Foreground="{Binding EngineStatusColor}" FontSize="9" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Draggable Middle Spacer -->
                <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                <!-- Window Control Buttons (Minimize, Maximize/Restore, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowChromeButtonStyle}" Tag="{StaticResource IconMinimize}" Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource WindowChromeButtonStyle}" Tag="{StaticResource IconMaximize}" Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource WindowChromeCloseButtonStyle}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Left Navigation Sidebar -->
            <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource BrushBgObsidian}">
                <DockPanel>
                    <!-- Nav Items -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                        <TextBlock Text="PROTECTION CENTER" Foreground="{StaticResource BrushTextDim}" Margin="20,8,0,8" FontSize="10" FontWeight="Bold"/>
                        <RadioButton Content="Dashboard" Tag="{StaticResource IconShield}" Style="{StaticResource CyberNavButtonStyle}"
                                     IsChecked="True" Command="{Binding NavigateDashboardCommand}" GroupName="NavGroup"/>
                        <RadioButton Content="Scan Center" Tag="{StaticResource IconRadar}" Style="{StaticResource CyberNavButtonStyle}"
                                     Command="{Binding NavigateScanCenterCommand}" GroupName="NavGroup"/>
                        <RadioButton Content="Quarantine Vault" Tag="{StaticResource IconLockVault}" Style="{StaticResource CyberNavButtonStyle}"
                                     Command="{Binding NavigateQuarantineCommand}" GroupName="NavGroup"/>

                        <TextBlock Text="ADVANCED DEFENSE" Foreground="{StaticResource BrushTextDim}" Margin="20,20,0,8" FontSize="10" FontWeight="Bold"/>
                        <RadioButton Content="Anti-Tamper Audit" Tag="{StaticResource IconBugAudit}" Style="{StaticResource CyberNavButtonStyle}"
                                     Command="{Binding NavigateAntiTamperCommand}" GroupName="NavGroup"/>
                        <RadioButton Content="Zip-Bomb Auditor" Tag="{StaticResource IconArchiveBomb}" Style="{StaticResource CyberNavButtonStyle}"
                                     Command="{Binding NavigateZipBombCommand}" GroupName="NavGroup"/>
                        <RadioButton Content="Signatures Database" Tag="{StaticResource IconDatabase}" Style="{StaticResource CyberNavButtonStyle}"
                                     Command="{Binding NavigateSignaturesCommand}" GroupName="NavGroup"/>
                        <RadioButton Content="Security Policies" Tag="{StaticResource IconSettings}" Style="{StaticResource CyberNavButtonStyle}"
                                     Command="{Binding NavigateSettingsCommand}" GroupName="NavGroup"/>
                    </StackPanel>

                    <!-- Bottom Status Indicator -->
                    <Border DockPanel.Dock="Bottom" Background="#0C1322" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Margin="12" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding EngineStatusColor}" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding EngineStatusText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="v2.1.0-ENTERPRISE (x64)" Foreground="{StaticResource BrushTextDim}" FontSize="9" Margin="14,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- Right Dynamic Content Region -->
            <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource BrushBgDeep}">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
