<Window x:Class="Vantor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vantor Security" Height="600" Width="950"
        WindowStyle="None" AllowsTransparency="True" 
        Background="Transparent" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Margin="10,2">
                            <ContentPresenter VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252525"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#222222"/>
        </Style>

        <Style x:Key="DarkRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#151515"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VantorDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DarkColumnHeader}"/>
            <Setter Property="RowStyle" Value="{StaticResource DarkRowStyle}"/>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Button">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="border" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="RotateScanner" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ScannerRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:3"/>
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="15" Background="#0C0C0C" BorderBrush="#252525" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#121212" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                    <Button Content="≡" Foreground="White" Background="Transparent" FontSize="20" Width="35" Click="ToggleSidebar_Click" Cursor="Hand" BorderThickness="0"/>
                    <TextBlock Text="VANTOR SECURITY" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Style="{StaticResource ControlButtonStyle}" Click="MinimizeButton_Click"/>
                    <Button Content="✕" Style="{StaticResource ControlButtonStyle}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="SidebarUI" Grid.Row="1" Grid.Column="0" Background="#121212" Width="220" ClipToBounds="True">
                <DockPanel>
                    <StackPanel x:Name="SidebarContent" DockPanel.Dock="Top">
                        <TextBlock Text="MAIN MENU" Foreground="#444" Margin="25,20,0,10" FontSize="10" FontWeight="Bold"/>
                        <Button Content="🛡️ Dashboard" Style="{StaticResource NavButtonStyle}" Click="NavDashboard_Click"/>
                        <Button Content="📅 Scan History" Style="{StaticResource NavButtonStyle}" Click="NavHistory_Click"/>
                    </StackPanel>
                    <Border x:Name="BackgroundIndicator" DockPanel.Dock="Bottom" Background="#1A1A1A" Margin="10" CornerRadius="8" Padding="10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#007ACC" Margin="0,0,10,0"/>
                            <TextBlock Text="Scan Running..." Foreground="#888" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1">

                <Grid x:Name="DashboardView">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30">
                            <TextBlock Text="System Protection" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,20"/>
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource CardStyle}" Tag="quick" Click="StartScan_Click" Margin="5" Height="100">
                                    <StackPanel>
                                        <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Quick Scan" Foreground="White" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource CardStyle}" Tag="full" Click="StartScan_Click" Margin="5" Height="100">
                                    <StackPanel>
                                        <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Full Scan" Foreground="White" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <TextBlock Text="Quarantined Threats" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="5,30,0,10"/>
                            <Border Background="#121212" CornerRadius="10" BorderBrush="#252525" BorderThickness="1" MinHeight="250">
                                <Grid>
                                    <TextBlock x:Name="txtEmptyQuarantineMsg" Text="Your system is clean." Foreground="#444" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <DataGrid x:Name="dgQuarantine" Style="{StaticResource VantorDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="FILE NAME" Binding="{Binding FileName}" Width="*"/>
                                            <DataGridTextColumn Header="DETECTION DATE" Binding="{Binding Date}" Width="Auto"/>
                                            <DataGridTemplateColumn Header="ACTIONS" Width="160">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Restore" Click="ActionRestore_Click" Margin="0,0,8,0" Padding="10,4" Background="#1A1A1A" Foreground="#007ACC" BorderThickness="1" BorderBrush="#333" FontSize="10" Cursor="Hand"/>
                                                            <Button Content="Delete" Click="ActionDelete_Click" Padding="10,4" Background="#1A1A1A" Foreground="#FF4B4B" BorderThickness="1" BorderBrush="#333" FontSize="10" Cursor="Hand"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ScanView" Visibility="Collapsed" Background="#0C0C0C">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Width="220" Height="220">
                            <Canvas x:Name="DotRingCanvas" Width="220" Height="220"/>
                            <Grid x:Name="ScannerNode" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="ScannerRotation" Angle="0"/>
                                </Grid.RenderTransform>
                                <Ellipse Width="12" Height="12" Fill="#007ACC" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,0,0">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="15"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Width="6" Height="6" Fill="#007ACC" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="txtScanPercent" Text="0%" Foreground="White" FontSize="42" FontWeight="Light" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtScanStatus" Text="S C A N N I N G" Foreground="#007ACC" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="txtScanPath" Text="..." Foreground="#444" FontSize="11" Margin="0,40,0,0" Width="500" TextAlignment="Center" TextWrapping="NoWrap" FontFamily="Consolas"/>
                        <Button Content="ABORT SCAN" Click="CancelScan_Click" Margin="0,40,0,0" Width="120" Height="35" Background="Transparent" Foreground="#666" BorderBrush="#333"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="HistoryView" Visibility="Collapsed" Background="#0C0C0C">
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Scan History" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,20"/>
                        <DataGrid x:Name="dgHistory" Grid.Row="1" Style="{StaticResource VantorDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SESSION ID" Binding="{Binding SID}" Width="150"/>
                                <DataGridTextColumn Header="DATE &amp; SUMMARY" Binding="{Binding Timestamp}" Width="*"/>
                                <DataGridTemplateColumn Header="THREATS" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Malicious}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#555"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Malicious}" Value="0">
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Malicious}" Value="1">
                                                                <Setter Property="Foreground" Value="#FF4B4B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Malicious}" Value="2">
                                                                <Setter Property="Foreground" Value="#FF4B4B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Malicious}" Value="3">
                                                                <Setter Property="Foreground" Value="#FF4B4B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <Grid x:Name="ScanSummaryView" Visibility="Collapsed" Background="#0C0C0C">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Scan Complete" Foreground="White" FontSize="28" Margin="0,0,0,40"/>
                        <UniformGrid Columns="3" Width="500">
                            <StackPanel>
                                <TextBlock Text="Safe" Foreground="#888" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="countSafe" Text="0" Foreground="#4CAF50" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Malicious" Foreground="#888" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="countMalicious" Text="0" Foreground="#F44336" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Quarantined" Foreground="#888" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="countQuarantined" Text="0" Foreground="#007ACC" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                        <Button Content="DONE" Height="40" Width="160" Background="#161616" Foreground="White" Margin="0,50,0,0" Click="SummaryDone_Click"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>