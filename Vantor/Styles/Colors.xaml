<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Deep Obsidian & Cyber Backgrounds -->
    <Color x:Key="ColorBgObsidian">#060910</Color>
    <Color x:Key="ColorBgDeep">#0A0F1D</Color>
    <Color x:Key="ColorBgSurface">#10172A</Color>
    <Color x:Key="ColorBgCard">#131D35</Color>
    <Color x:Key="ColorBgCardHover">#1A2744</Color>
    <Color x:Key="ColorBgGlass">#D80F172A</Color>

    <SolidColorBrush x:Key="BrushBgObsidian" Color="{StaticResource ColorBgObsidian}"/>
    <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource ColorBgDeep}"/>
    <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource ColorBgSurface}"/>
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}"/>
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}"/>
    <SolidColorBrush x:Key="BrushBgGlass" Color="{StaticResource ColorBgGlass}"/>

    <!-- Cyber Borders & Dividers -->
    <Color x:Key="ColorBorderSubtle">#1E293B</Color>
    <Color x:Key="ColorBorderHighlight">#334155</Color>
    <Color x:Key="ColorBorderGlass">#3038BDF8</Color>

    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}"/>
    <SolidColorBrush x:Key="BrushBorderHighlight" Color="{StaticResource ColorBorderHighlight}"/>
    <SolidColorBrush x:Key="BrushBorderGlass" Color="{StaticResource ColorBorderGlass}"/>

    <!-- Neon Cyber Accents -->
    <Color x:Key="ColorCyanAccent">#00F0FF</Color>
    <Color x:Key="ColorCyanHover">#38BDF8</Color>
    <Color x:Key="ColorCyanGlow">#3300F0FF</Color>

    <SolidColorBrush x:Key="BrushCyanAccent" Color="{StaticResource ColorCyanAccent}"/>
    <SolidColorBrush x:Key="BrushCyanHover" Color="{StaticResource ColorCyanHover}"/>
    <SolidColorBrush x:Key="BrushCyanGlow" Color="{StaticResource ColorCyanGlow}"/>

    <!-- Security State Accents -->
    <Color x:Key="ColorEmeraldSafe">#10B981</Color>
    <Color x:Key="ColorEmeraldGlow">#3310B981</Color>
    <Color x:Key="ColorCrimsonThreat">#F43F5E</Color>
    <Color x:Key="ColorCrimsonGlow">#33F43F5E</Color>
    <Color x:Key="ColorAmberWarning">#F59E0B</Color>
    <Color x:Key="ColorAmberGlow">#33F59E0B</Color>

    <SolidColorBrush x:Key="BrushEmeraldSafe" Color="{StaticResource ColorEmeraldSafe}"/>
    <SolidColorBrush x:Key="BrushEmeraldGlow" Color="{StaticResource ColorEmeraldGlow}"/>
    <SolidColorBrush x:Key="BrushCrimsonThreat" Color="{StaticResource ColorCrimsonThreat}"/>
    <SolidColorBrush x:Key="BrushCrimsonGlow" Color="{StaticResource ColorCrimsonGlow}"/>
    <SolidColorBrush x:Key="BrushAmberWarning" Color="{StaticResource ColorAmberWarning}"/>
    <SolidColorBrush x:Key="BrushAmberGlow" Color="{StaticResource ColorAmberGlow}"/>

    <!-- Text Typography Brushes -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#64748B"/>
    <SolidColorBrush x:Key="BrushTextDim" Color="#475569"/>

</ResourceDictionary>
