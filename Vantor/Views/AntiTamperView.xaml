<UserControl x:Class="Vantor.Views.AntiTamperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:Vantor.Common"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <common:VerdictToBrushConverter x:Key="VerdictToBrush"/>
        <common:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">
            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="User-Mode Anti-Tamper &amp; Integrity Audit" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Continuous runtime code verification, inline hook defense, and memory watchdog telemetry." Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- 4 Defense Rings Card -->
            <Border Style="{StaticResource GlassCardStyle}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Active Defense Rings" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="RUN FULL INTEGRITY AUDIT" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RunAuditCommand}" HorizontalAlignment="Right" Padding="18,8"/>
                    </Grid>

                    <StackPanel>
                        <!-- Ring 1: Authenticode -->
                        <Border Background="#090E1A" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconShieldCheck}" Fill="{StaticResource BrushCyanAccent}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Authenticode Digital Signature Verification" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Validates PE signature certificates and trusted root certification authority." Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#162947" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AuthenticodeStatus}" Foreground="{Binding AuthenticodeStatus, Converter={StaticResource VerdictToBrush}}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Ring 2: In-Memory Text Section -->
                        <Border Background="#090E1A" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconAuditEye}" Fill="{StaticResource BrushCyanAccent}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Runtime .text Section In-Memory Self-Hash" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Detects memory patching, byte-level DLL injection, and reflective code alterations." Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#162947" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TextSectionStatus}" Foreground="{Binding TextSectionStatus, Converter={StaticResource VerdictToBrush}}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Ring 3: Inline Hook Watchdog -->
                        <Border Background="#090E1A" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconBugAudit}" Fill="{StaticResource BrushCyanAccent}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Critical Win32 API Inline Hook Detection" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Audits ntdll, kernel32, and user32 function preludes for malicious 0xE9 indirect jumps." Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#162947" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ApiHooksStatus}" Foreground="{Binding ApiHooksStatus, Converter={StaticResource VerdictToBrush}}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Ring 4: Anti-Debug -->
                        <Border Background="#090E1A" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconLockVault}" Fill="{StaticResource BrushCyanAccent}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Anti-Debugging &amp; Hardware Breakpoints (Dr0-Dr3)" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Prevents debugger attachment, thread suspension, and hypervisor reverse engineering." Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#162947" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AntiDebugStatus}" Foreground="{Binding AntiDebugStatus, Converter={StaticResource VerdictToBrush}}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Audit Status Readout Console -->
            <Border Background="#060A14" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock Text="SYSTEM DIAGNOSTIC CONSOLE" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding AuditSummary}" Foreground="{StaticResource BrushCyanAccent}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
