<UserControl x:Class="Vantor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Vantor.ViewModels"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">
            <!-- System Status Hero Card -->
            <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1.5" CornerRadius="14" Padding="28,24" Margin="0,0,0,28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="#059669" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconShieldCheck}" Fill="#10B981" Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="SYSTEM IS SECURE &amp; SHIELDED" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Win32 Antivirus Service, O(1) memory-mapped Bloom index, and anti-tamper watchdog active."
                                   Foreground="#A7F3D0" FontSize="12" Margin="32,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="RUN INTEGRITY CHECK" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding RunIntegrityCheckCommand}" VerticalAlignment="Center" Padding="20,10"/>
                </Grid>
            </Border>

            <!-- Quick Action Cards Section -->
            <TextBlock Text="Instant Defense Actions" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>
            <UniformGrid Columns="3" Margin="0,0,0,28">
                <!-- Quick Scan Card -->
                <Button Style="{StaticResource InteractiveActionCardStyle}" Command="{Binding QuickScanCommand}" Margin="0,0,12,0" Height="115">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="42" Height="42" Background="#162947" CornerRadius="21" Margin="0,0,0,10">
                            <Path Data="{StaticResource IconZap}" Fill="{StaticResource BrushCyanAccent}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Quick Scan" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="Downloads, Desktop, Startup" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Full Scan Card -->
                <Button Style="{StaticResource InteractiveActionCardStyle}" Command="{Binding FullScanCommand}" Margin="6,0,6,0" Height="115">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="42" Height="42" Background="#162947" CornerRadius="21" Margin="0,0,0,10">
                            <Path Data="{StaticResource IconScanSearch}" Fill="{StaticResource BrushCyanAccent}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Full System Scan" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="All fixed local drives" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Custom Scan Card -->
                <Button Style="{StaticResource InteractiveActionCardStyle}" Command="{Binding CustomScanCommand}" Margin="12,0,0,0" Height="115">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="42" Height="42" Background="#162947" CornerRadius="21" Margin="0,0,0,10">
                            <Path Data="{StaticResource IconFolderOpen}" Fill="{StaticResource BrushCyanAccent}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Custom Scan" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="Audit specific folder or file" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Metrics & Core Statistics -->
            <TextBlock Text="Telemetry &amp; Engine Status" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,28" Padding="24">
                <UniformGrid Columns="3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="INDEXED SIGNATURES" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalSignatures}" Foreground="{StaticResource BrushCyanAccent}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Sub-microsecond Bloom Filter" Foreground="{StaticResource BrushTextDim}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="QUARANTINED THREATS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding QuarantineCount}" Foreground="{StaticResource BrushAmberWarning}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="AES-256-GCM Vault Isolated" Foreground="{StaticResource BrushTextDim}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="MEMORY INTEGRITY" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding MemoryIntegrity}" Foreground="{StaticResource BrushEmeraldSafe}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Inline Hook Watchdog Active" Foreground="{StaticResource BrushTextDim}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Recent Security Telemetry Feed -->
            <TextBlock Text="Real-Time Protection Event Stream" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>
            <Border Style="{StaticResource GlassCardStyle}" Padding="16">
                <ItemsControl ItemsSource="{Binding RecentEvents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#090E1A" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconActivityPulse}" Fill="{StaticResource BrushCyanAccent}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ThreatDetails}" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#162947" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushEmeraldSafe}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Drag & Drop Hint -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Path Data="{StaticResource IconInfo}" Fill="{StaticResource BrushTextMuted}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="ProTip: Drag and drop any executable or archive onto this window to instantly audit with zero decompression."
                           Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
