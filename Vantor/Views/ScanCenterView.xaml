<UserControl x:Class="Vantor.Views.ScanCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:Vantor.Common"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <common:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <common:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <!-- Radar Sweep Rotation Animation -->
        <Storyboard x:Key="RadarSweepStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RadarSweepTransform"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:3"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBgDeep}">
        <!-- ==================== 1. IDLE / SCAN PROFILES HUB ==================== -->
        <Grid Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Scan Center" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Hardware-accelerated C++ Win32 memory-mapped signature scanning, entropy scoring, and real-time quarantine"
                           Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 3 Scan Profile Cards -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
                <!-- Profile 1: Quick Scan -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,12,0" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Width="48" Height="48" Background="#18233C" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <Path Data="{StaticResource IconZap}" Fill="{StaticResource BrushCyanAccent}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Quick Scan" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        
                        <TextBlock Grid.Row="2" Text="Scans active user profiles, Downloads, Desktop, temporary staging folders, and memory-loaded binaries for fast triage."
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,16"/>

                        <TextBlock Grid.Row="3" Text="ESTIMATED DURATION: ~30 SEC" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,16"/>

                        <Button Grid.Row="4" Content="RUN QUICK SCAN" Command="{Binding StartQuickScanCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="40"/>
                    </Grid>
                </Border>

                <!-- Profile 2: Full System Scan -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="6,0,6,0" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Width="48" Height="48" Background="#132B25" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <Path Data="{StaticResource IconShield}" Fill="{StaticResource BrushEmeraldSafe}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Full System Scan" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        
                        <TextBlock Grid.Row="2" Text="Exhaustive deep-sector inspection across all fixed storage volumes, system directories, program files, and compressed payloads."
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,16"/>

                        <TextBlock Grid.Row="3" Text="ESTIMATED DURATION: ~5-15 MIN" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,16"/>

                        <Button Grid.Row="4" Content="RUN FULL SCAN" Command="{Binding StartFullScanCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="40"/>
                    </Grid>
                </Border>

                <!-- Profile 3: Custom Directory Scan -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="12,0,0,0" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Width="48" Height="48" Background="#261A35" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <Path Data="{StaticResource IconSearch}" Fill="#A78BFA" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Custom Directory" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        
                        <TextBlock Grid.Row="2" Text="Select any specific directory, flash drive, or downloaded package for focused heuristic evaluation and cryptographic validation."
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,16"/>

                        <TextBlock Grid.Row="3" Text="ESTIMATED DURATION: TARGET DEPENDENT" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,16"/>

                        <Button Grid.Row="4" Content="CHOOSE FOLDER" Command="{Binding StartCustomScanCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="40"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Drag & Drop Quick Notice -->
            <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" CornerRadius="10" Padding="20,14" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconFolder}" Fill="{StaticResource BrushCyanAccent}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Instant Drag &amp; Drop Scanning" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Drag and drop any file, folder, or zip archive directly onto the window at any time to run instant targeted analysis." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. ACTIVE SCANNING VIEW ==================== -->
        <Grid Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Info -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="{Binding ScanMode}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Hardware-accelerated C++ Win32 memory-mapped signature and heuristic pipeline" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Main Radar & Telemetry Split -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Radar Sweep HUD -->
                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="24" Margin="0,0,16,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Radar Sweep Canvas -->
                        <Grid Width="220" Height="220">
                            <!-- Outer Rings -->
                            <Ellipse Stroke="{StaticResource BrushBorderSubtle}" StrokeThickness="1.5" Width="218" Height="218"/>
                            <Ellipse Stroke="{StaticResource BrushBorderSubtle}" StrokeThickness="1" StrokeDashArray="4 4" Width="160" Height="160"/>
                            <Ellipse Stroke="{StaticResource BrushBorderSubtle}" StrokeThickness="1" Width="100" Height="100"/>
                            <Ellipse Stroke="{StaticResource BrushCyanAccent}" StrokeThickness="1.5" Width="40" Height="40" Opacity="0.4"/>

                            <!-- Rotating Sweep Line -->
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="RadarSweepTransform" Angle="0"/>
                                </Grid.RenderTransform>
                                <Line X1="110" Y1="110" X2="110" Y2="5" Stroke="{StaticResource BrushCyanAccent}" StrokeThickness="2">
                                    <Line.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00F0FF" Opacity="0.8"/>
                                    </Line.Effect>
                                </Line>
                            </Grid>

                            <!-- Center Readout -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="ANALYZING" Foreground="{StaticResource BrushCyanAccent}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Speed & Stopwatch Metrics -->
                        <UniformGrid Columns="2" Margin="0,24,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="THROUGHPUT" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ThroughputText}" Foreground="{StaticResource BrushCyanAccent}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ELAPSED TIME" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ElapsedText}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Right Live Telemetry Ticker & Counts -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Scoreboard Badges -->
                    <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,16">
                        <UniformGrid Columns="3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="FILES SCANNED" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding FilesScannedCount}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="THREATS FLAGGED" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ThreatsDetectedCount}" Foreground="{StaticResource BrushCrimsonThreat}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="CONTAINED" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding FilesQuarantinedCount}" Foreground="{StaticResource BrushAmberWarning}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- Live File Stream -->
                    <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Live Scanned File Stream" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LiveScanFeed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#090E1A" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FilePath}" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" Background="#162947" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushEmeraldSafe}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Path Bar & Abort Button -->
            <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" CornerRadius="10" Padding="18,12" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CURRENT TARGET" Foreground="{StaticResource BrushTextMuted}" FontSize="9" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentScanningPath}" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="ABORT SCAN" Command="{Binding AbortScanCommand}" Style="{StaticResource DangerButtonStyle}" Padding="20,8"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3. SCAN SUMMARY VIEW ==================== -->
        <Grid Visibility="{Binding IsScanComplete, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" Background="#132B25" CornerRadius="32" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconCheckCircle}" Fill="{StaticResource BrushEmeraldSafe}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Scan Audit Complete" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Comprehensive detection report from C++ engine" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,4,0,28" HorizontalAlignment="Center"/>

                <Border Style="{StaticResource GlassCardStyle}" Padding="36,24" Width="550">
                    <UniformGrid Columns="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CLEAN FILES" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SafeFilesCount}" Foreground="{StaticResource BrushEmeraldSafe}" FontSize="32" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="MALICIOUS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ThreatsDetectedCount}" Foreground="{StaticResource BrushCrimsonThreat}" FontSize="32" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="QUARANTINED" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding FilesQuarantinedCount}" Foreground="{StaticResource BrushAmberWarning}" FontSize="32" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <Button Content="RUN ANOTHER SCAN" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetToIdleCommand}"
                            Width="190" Height="42" Margin="0,0,14,0"/>
                    <Button Content="RETURN TO DASHBOARD" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ReturnToDashboardCommand}"
                            Width="210" Height="42"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
